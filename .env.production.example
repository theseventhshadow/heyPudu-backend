# Shared Cognito configuration
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/replace-with-user-pool-id
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/replace-with-user-pool-id/.well-known/jwks.json

# RDS PostgreSQL connection. Use the private RDS endpoint from the EC2 VPC.
DB_URL_AUTH=jdbc:postgresql://replace-with-rds-endpoint:5432/heypudu?currentSchema=heypudu_auth
DB_URL_USERS=jdbc:postgresql://replace-with-rds-endpoint:5432/heypudu?currentSchema=heypudu_users
DB_URL_POSTS=jdbc:postgresql://replace-with-rds-endpoint:5432/heypudu?currentSchema=heypudu_posts
DB_URL_INTERACTIONS=jdbc:postgresql://replace-with-rds-endpoint:5432/heypudu?currentSchema=heypudu_interactions

# Database credentials. Prefer separate RDS users per schema.
DB_USERNAME_AUTH=replace-with-auth-db-user
DB_PASSWORD_AUTH=replace-with-auth-db-password
DB_USERNAME_USERS=replace-with-users-db-user
DB_PASSWORD_USERS=replace-with-users-db-password
DB_USERNAME_POSTS=replace-with-posts-db-user
DB_PASSWORD_POSTS=replace-with-posts-db-password
DB_USERNAME_INTERACTIONS=replace-with-interactions-db-user
DB_PASSWORD_INTERACTIONS=replace-with-interactions-db-password

# S3 buckets
S3_AVATARS_BUCKET=replace-with-avatars-bucket
S3_AUDIO_BUCKET=replace-with-audio-bucket
S3_COVERS_BUCKET=replace-with-covers-bucket
