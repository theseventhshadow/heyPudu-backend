# ============================================================
# Variables para docker-compose.live.prod.yml (EC2 3)
#
#   cp live-prod.env.example live-prod.env   # nunca commitear el .env real
#
# Completar con los valores reales de la VPC y de Neon.
# ============================================================

# ---------- Cognito (mismos valores que el resto del backend) ----------
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json

# ---------- Neon PostgreSQL (schemas por servicio) ----------
DB_URL_LIVE=jdbc:postgresql://HOST/neondb?sslmode=require&channel_binding=require&currentSchema=heypudu_live
DB_USERNAME_LIVE=NEO_USER
DB_PASSWORD_LIVE=NEO_PASSWORD
DB_URL_ANALYTICS=jdbc:postgresql://HOST/neondb?sslmode=require&channel_binding=require&currentSchema=heypudu_analytics
DB_USERNAME_ANALYTICS=NEO_USER
DB_PASSWORD_ANALYTICS=NEO_PASSWORD

# ---------- Servicios internos ----------
# IP privada de la EC2 1 (backend), no la pública
CLIENTS_USERS_BASE_URL=http://10.0.0.0:8082

# ---------- RabbitMQ (EC2 2) ----------
RABBITMQ_HOST=10.0.0.0
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=heypudu
RABBITMQ_PASSWORD=CAMBIAR

# ---------- Kafka (ZooKeeper + 2 brokers dentro del compose) ----------
KAFKA_TOPIC_LIVE_EVENTS=heypudu.live.events
KAFKA_TOPIC_POSTS_EVENTS=heypudu.posts.events

# ---------- MediaMTX / TLS ----------
# Dominio que apunta a la IP pública (o Elastic IP) de la EC2 3
MEDIAMTX_HOST=live.tudominio.com
MEDIAMTX_PUBLIC_URL=https://live.tudominio.com
MEDIAMTX_SERVICE_TOKEN=CAMBIAR_TOKEN_LARGO
MEDIAMTX_ALLOWED_ORIGIN=https://heypudu.vercel.app
ACME_EMAIL=tu@correo.com
